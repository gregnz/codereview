{
  "name": "codereview",
  "version": "1.0.0",
  "description": "AI Code Review: Outcome, Hierarchy & Blast Radius Explorer",
  "main": "tools/cli.js",
  "bin": {
    "codereview": "./tools/cli.js",
    "ast-outline": "./tools/ast-outline.js",
    "ast-inspect": "./tools/ast-inspect.js",
    "conversation-analyzer": "./tools/conversation-analyzer.js"
  },
  "scripts": {
    "cli": "node tools/cli.js",
    "ast": "node tools/ast-outline.js",
    "analyze": "npm run analyze:lint && npm run analyze:map && npm run analyze:graph && npm run analyze:d3",
    "analyze:dir": "node tools/ast-outline.js",
    "analyze:lint": "node tools/ast-outline.js tools --lint",
    "analyze:map": "node tools/ast-outline.js tools --write-map codereview_symbol_map.md",
    "analyze:graph": "node tools/ast-outline.js tools --export-graph codereview_graph.json",
    "analyze:d3": "node tools/ast-outline.js tools --export-graph graph.json",
    "analyze:inspect": "node tools/ast-inspect.js",
    "inspect": "node tools/ast-inspect.js",
    "analyze:conversation": "node tools/conversation-analyzer.js",
    "conversation": "node tools/conversation-analyzer.js",
    "export": "node tools/cli.js sync",
    "open": "open index.html",
    "test": "node --test test/**/*.test.js"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "tree-sitter": "^0.25.1",
    "tree-sitter-javascript": "^0.25.0"
  }
}
