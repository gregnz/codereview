{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "UniversalCognitiveCodebaseIR",
  "description": "Universal Cognitive Schema for Language-Agnostic Codebase Verification & Mental Model Workbenches",
  "type": "object",
  "required": [
    "projectName",
    "targetPath",
    "modules",
    "structs",
    "functions",
    "concurrencyReport",
    "securityReport",
    "bridgeEndpoints",
    "invariants",
    "sourceFiles",
    "summary"
  ],
  "properties": {
    "projectName": { "type": "string" },
    "targetPath": { "type": "string" },
    "runtime": { "type": "string", "enum": ["go", "dotnet", "java", "python", "node", "rust", "polyglot"] },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "description", "files", "role", "riskScore"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "description": { "type": "string" },
          "files": { "type": "array", "items": { "type": "string" } },
          "role": { "type": "string" },
          "riskScore": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] }
        }
      }
    },
    "structs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "file", "line", "fields"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "fields": { "type": "array" },
          "hasMutex": { "type": "boolean" },
          "mutexType": { "type": "string" },
          "methods": { "type": "array", "items": { "type": "string" } },
          "doc": { "type": "string" }
        }
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "file", "startLine", "endLine", "signature"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "receiver": { "type": "string" },
          "file": { "type": "string" },
          "startLine": { "type": "integer" },
          "endLine": { "type": "integer" },
          "signature": { "type": "string" },
          "calls": { "type": "array", "items": { "type": "string" } },
          "doc": { "type": "string" }
        }
      }
    },
    "concurrencyReport": {
      "type": "object",
      "required": ["totalMutexes", "totalGoroutines", "hazards", "idiomExplainers"],
      "properties": {
        "totalMutexes": { "type": "integer" },
        "totalGoroutines": { "type": "integer" },
        "hazards": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "severity", "title", "file", "line", "description", "remedy", "category"],
            "properties": {
              "id": { "type": "string" },
              "severity": { "type": "string", "enum": ["CRITICAL", "WARNING", "INFO"] },
              "title": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "description": { "type": "string" },
              "remedy": { "type": "string" },
              "category": { "type": "string" }
            }
          }
        },
        "idiomExplainers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["concept", "summary", "whyItMatters", "goRule", "codeExample"],
            "properties": {
              "concept": { "type": "string" },
              "summary": { "type": "string" },
              "whyItMatters": { "type": "string" },
              "goRule": { "type": "string" },
              "codeExample": { "type": "string" }
            }
          }
        }
      }
    },
    "securityReport": {
      "type": "object",
      "required": ["taintFlows", "sanitizerAudits", "sqlChecks"],
      "properties": {
        "taintFlows": { "type": "array" },
        "sanitizerAudits": { "type": "array" },
        "sqlChecks": { "type": "array" }
      }
    },
    "bridgeEndpoints": { "type": "array" },
    "invariants": { "type": "array" },
    "sourceFiles": { "type": "object" },
    "summary": { "type": "string" }
  }
}
